<div id="telegram-modal-overlay" class="modal-overlay hidden">
    <div class="telegram-modal">
        <button id="close-telegram-modal" class="close-btn" aria-label="Cerrar">
            <i class="fas fa-times"></i>
        </button>
        
        <div class="telegram-icon-container">
            <div class="icon-circle">
                <i class="fas fa-mobile-screen"></i>
            </div>
        </div>

        <h2>¡Bienvenido a La Página!</h2>
        <p>Instala la app en tu móvil para acceder a todo con un toque, o únete al Telegram para recibir las últimas noticias, exámenes y eventos sin tener que consultar la página. Sin spam, solo avisos importantes.</p>

        <div class="btn-group">
            <button id="install-pwa-btn" class="pwa-btn" style="display: none;">
                <i class="fas fa-download"></i> Instalar la App
            </button>
            <a href="https://t.me/+Itq-KhGnWLZiNTZk" target="_blank" id="join-telegram-btn" class="telegram-btn">
                <i class="fab fa-telegram"></i> Unirme al Telegram
            </a>
        </div>
        
        <button id="maybe-later-telegram" class="secondary-link">Quizás más tarde</button>
    </div>
</div>

<style>
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.7);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        backdrop-filter: blur(4px);
        padding: 20px;
    }

    .hidden {
        display: none !important;
    }

    .telegram-modal {
        background: white;
        padding: 2.5rem 2rem;
        border-radius: 24px;
        max-width: 400px;
        width: 100%;
        text-align: center;
        position: relative;
        box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
        animation: modalShow 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    @keyframes modalShow {
        from { transform: scale(0.8); opacity: 0; }
        to { transform: scale(1); opacity: 1; }
    }

    .close-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #f1f5f9;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        color: #64748b;
        transition: all 0.2s;
    }

    .close-btn:hover {
        background: #e2e8f0;
        color: #1e293b;
    }

    .telegram-icon-container {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: center;
    }

    .icon-circle {
        width: 80px;
        height: 80px;
        background: #2000ad;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 2.5rem;
        box-shadow: 0 10px 15px -3px rgba(32, 0, 173, 0.3);
    }

    h2 {
        color: #1e293b;
        font-size: 1.5rem;
        font-weight: 800;
        margin-bottom: 1rem;
    }

    p {
        color: #64748b;
        line-height: 1.6;
        margin-bottom: 2rem;
    }

    .btn-group {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .pwa-btn,
    .telegram-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        color: white;
        text-decoration: none;
        padding: 14px 28px;
        border-radius: 14px;
        font-weight: 700;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        border: none;
        cursor: pointer;
        font-family: inherit;
    }

    .pwa-btn {
        background: #2000ad;
    }

    .pwa-btn:hover {
        background: #1a0089;
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(32, 0, 173, 0.3);
    }

    .telegram-btn {
        background: #0088cc;
    }

    .telegram-btn:hover {
        background: #0077b5;
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
    }

    .secondary-link {
        background: none;
        border: none;
        color: #94a3b8;
        margin-top: 1.5rem;
        font-weight: 600;
        cursor: pointer;
        font-size: 0.9rem;
        transition: color 0.2s;
    }

    .secondary-link:hover {
        color: #64748b;
        text-decoration: underline;
    }
</style>

<script>
    let deferredPrompt: any = null;

    // Capturar el evento de instalación de la PWA lo antes posible
    window.addEventListener('beforeinstallprompt', (e) => {
        e.preventDefault();
        deferredPrompt = e;
        updateInstallBtnVisibility();
    });

    function updateInstallBtnVisibility() {
        const installBtn = document.getElementById('install-pwa-btn');
        if (!installBtn) return;

        // Ocultar si ya está instalada
        const isStandalone = window.matchMedia('(display-mode: standalone)').matches
            || (window.navigator as any).standalone === true;
        if (isStandalone) {
            (installBtn as HTMLElement).style.display = 'none';
            return;
        }

        if (deferredPrompt) {
            (installBtn as HTMLElement).style.display = 'flex';
        } else {
            // Safari iOS no dispara beforeinstallprompt: mostrar instrucciones
            const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
            if (isIOS) {
                (installBtn as HTMLElement).style.display = 'flex';
                installBtn.innerHTML = '<i class="fas fa-square-plus"></i> Compartir → "Añadir a inicio"';
            }
        }
    }

    function initTelegramModal() {
        const overlay = document.getElementById('telegram-modal-overlay');
        const closeBtn = document.getElementById('close-telegram-modal');
        const laterBtn = document.getElementById('maybe-later-telegram');
        const joinBtn = document.getElementById('join-telegram-btn');
        const installBtn = document.getElementById('install-pwa-btn') as HTMLButtonElement | null;

        if (!overlay) return;

        updateInstallBtnVisibility();

        // Verificar si ya se mostró o se unió
        const hasJoinedOrDismissed = localStorage.getItem('telegram-modal-dismissed');
        const now = new Date().getTime();

        // Si no se ha interactuado o han pasado más de 7 días desde el "quizás más tarde"
        if (!hasJoinedOrDismissed || (now - parseInt(hasJoinedOrDismissed)) > (7 * 24 * 60 * 60 * 1000)) {
            // Mostrar con un pequeño retraso para mejorar UX
            setTimeout(() => {
                overlay.classList.remove('hidden');
            }, 3000);
        }

        const dismiss = () => {
            overlay.classList.add('hidden');
            localStorage.setItem('telegram-modal-dismissed', new Date().getTime().toString());
        };

        const permanentDismiss = () => {
            overlay.classList.add('hidden');
            // Un valor muy alto para que no vuelva a aparecer (un año)
            localStorage.setItem('telegram-modal-dismissed', (new Date().getTime() + (365 * 24 * 60 * 60 * 1000)).toString());
        };

        // Instalación de la PWA
        installBtn?.addEventListener('click', async () => {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                if (outcome === 'accepted') {
                    permanentDismiss();
                }
                deferredPrompt = null;
            } else {
                // Fallback: instrucciones para navegadores sin beforeinstallprompt
                alert('Para instalar la app, usa el menú de tu navegador y elige "Añadir a pantalla de inicio".');
            }
        });

        // Ocultar el botón cuando la app se instala
        window.addEventListener('appinstalled', () => {
            if (installBtn) installBtn.style.display = 'none';
        });

        closeBtn?.addEventListener('click', dismiss);
        laterBtn?.addEventListener('click', dismiss);
        joinBtn?.addEventListener('click', permanentDismiss);

        // Cerrar al hacer clic fuera
        overlay.addEventListener('click', (e) => {
            if (e.target === overlay) dismiss();
        });
    }

    // Ejecutar al cargar la página
    document.addEventListener('DOMContentLoaded', initTelegramModal);
    // Para transiciones de View Transitions en Astro
    document.addEventListener('astro:after-swap', initTelegramModal);
</script>
